# Copiá este archivo como .env.local y llená los valores de tu proyecto Firebase
# (Consola Firebase > ⚙️ Configuración del proyecto > General > Tus apps > App web > firebaseConfig).
# Si lo dejás vacío (o no existe .env.local), la app corre en MODO DEMO (localStorage).
# Estas claves NO son secretas (van en el navegador); la seguridad está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Asistente con IA (opcional). URL de TU proxy (Cloudflare Worker o Google Apps Script, ver proxy/README.md).
# Vacío = asistente en modo local (gratis, sin servidor). NUNCA pongás aquí una clave de API.
VITE_AI_PROXY_URL=
